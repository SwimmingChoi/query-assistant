# HWGI Query Assistant — 환경변수 예시
# 실제 값을 채워서 backend/.env 로 복사하세요. .env 는 절대 커밋하지 않습니다.

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8090

# --- LLM (PoC: OpenAI / 추후: 사내 vLLM) ---
# OpenAI 사용 시
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# 사내 vLLM 전환 시 (예시)
# LLM_BASE_URL=http://<vllm-host>:5015/v1
# LLM_MODEL=gemma-4-26B-A4B-it
# LLM_API_KEY=

# --- Generation ---
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# --- 감사 로그 (SQLite) ---
DATABASE_PATH=./data/audit.sqlite3
